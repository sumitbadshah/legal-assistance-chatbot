# Copy this file to .env and fill in real values before running.

DATABASE_URL=postgresql://legal_user:legal_pass@localhost:5432/legal_assistant

# Generate a long random string for production, e.g.: openssl rand -hex 32
SECRET_KEY=change-this-in-production

# Get a real key from https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-2.5-flash

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
